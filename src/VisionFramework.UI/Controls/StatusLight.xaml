<UserControl x:Class="VisionFramework.UI.Controls.StatusLight"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Ellipse x:Name="Light" Width="12" Height="12" Margin="0,0,6,0"
                 Fill="{Binding OffColor, ElementName=Root}"
                 Stroke="#333" StrokeThickness="1"/>
        <TextBlock Text="{Binding Label, ElementName=Root}" 
                   Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
