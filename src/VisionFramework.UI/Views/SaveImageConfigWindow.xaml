<Window x:Class="VisionFramework.UI.Views.SaveImageConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="存图配置" Height="560" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="存图格式与路径" Foreground="#AAA" Margin="0,0,0,10">
            <Grid Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="图片格式：" Foreground="#CCC" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CbxFormat" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" SelectedIndex="0">
                    <ComboBoxItem Content="BMP (无损)"/>
                    <ComboBoxItem Content="JPG (压缩)"/>
                    <ComboBoxItem Content="PNG (无损压缩)"/>
                    <ComboBoxItem Content="IDB (VisionPro)"/>
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="存图路径：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtSavePath" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <Button Grid.Row="1" Grid.Column="2" Content="浏览..." Height="26" Margin="8,0,0,0" Background="#FF3D3D50" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnBrowse_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="保存内容" Foreground="#AAA" Margin="0,0,0,10">
            <StackPanel Margin="8,8,8,4">
                <CheckBox x:Name="ChkSaveOriginal" Content="保存原始图像" Foreground="#CCC" Margin="0,0,0,6" IsChecked="True"/>
                <CheckBox x:Name="ChkSaveRendered" Content="保存渲染图像（带叠加图形结果）" Foreground="#CCC" IsChecked="True"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="文件命名" Foreground="#AAA" Margin="0,0,0,10">
            <StackPanel Margin="8,8,8,4">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <CheckBox x:Name="ChkAddProductId" Content="产品ID" Foreground="#CCC" Margin="0,0,20,0" IsChecked="True"/>
                    <CheckBox x:Name="ChkAddTimestamp" Content="时间戳" Foreground="#CCC" Margin="0,0,20,0" IsChecked="True"/>
                    <CheckBox x:Name="ChkAddResult" Content="结果(OK/NG)" Foreground="#CCC" IsChecked="True"/>
                </StackPanel>
                <TextBlock Text="命名预览：" Foreground="#888" FontSize="11" Margin="0,4,0,2"/>
                <TextBlock x:Name="TblPreview" Text="{}{ProductId}_{Timestamp}_{Result}.bmp" Foreground="#7B68EE" FontSize="12" FontFamily="Consolas"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="目录与磁盘" Foreground="#AAA" Margin="0,0,0,10">
            <StackPanel Margin="8,8,8,4">
                <CheckBox x:Name="ChkDateFolder" Content="按日期创建子目录 (yyyyMMdd)" Foreground="#CCC" Margin="0,0,0,6" IsChecked="True"/>
                <CheckBox x:Name="ChkResultFolder" Content="按结果创建子目录 (OK / NG)" Foreground="#CCC" Margin="0,0,0,6"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="磁盘使用上限：" Foreground="#CCC" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SldDiskLimit" Minimum="50" Maximum="99" Value="90" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="TblDiskLimit" Text="90%" Foreground="#CCC" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="80" Height="32" Margin="0,0,10,0"
                    Background="#FF7B68EE" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" Height="32"
                    Background="#FF3D3D50" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
