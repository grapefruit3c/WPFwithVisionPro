<Window x:Class="VisionFramework.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统登录" Height="320" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E" ResizeMode="NoResize">
    <Grid Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="VisionFramework" FontSize="22" FontWeight="Bold"
                   Foreground="#7B68EE" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="0" Text="机器视觉检测系统" FontSize="12" Foreground="#888"
                   HorizontalAlignment="Center" Margin="0,30,0,0"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="用户名" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername" Height="32" FontSize="14"
                     Background="#FF2D2D3F" Foreground="White" BorderBrush="#444"
                     Padding="8,4" Text="admin"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="密码" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtPassword" Height="32" FontSize="14"
                         Background="#FF2D2D3F" Foreground="White" BorderBrush="#444"
                         Padding="8,4"/>
        </StackPanel>

        <Button Grid.Row="5" Content="登 录" Height="48" FontSize="18" FontWeight="Bold"
                Margin="0,4,0,0"
                Background="#FF7B68EE" Foreground="White" BorderThickness="0"
                Cursor="Hand" Click="BtnLogin_Click"/>
    </Grid>
</Window>
