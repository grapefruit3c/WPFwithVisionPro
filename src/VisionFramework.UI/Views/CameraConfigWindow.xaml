<Window x:Class="VisionFramework.UI.Views.CameraConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="相机配置" Height="480" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="连接信息" Foreground="#AAA" Margin="0,0,0,10">
            <Grid Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="相机类型：" Foreground="#CCC" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CbxType" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" SelectedIndex="0">
                    <ComboBoxItem Content="海康 (HikVision)"/>
                    <ComboBoxItem Content="大华 (Dahua)"/>
                    <ComboBoxItem Content="文件相机 (离线)"/>
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="IP/序列号：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtConnStr" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="触发模式：" Foreground="#CCC" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CbxTrigger" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" SelectedIndex="0">
                    <ComboBoxItem Content="软件触发"/>
                    <ComboBoxItem Content="硬件触发"/>
                    <ComboBoxItem Content="连续采集"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="图像参数" Foreground="#AAA" Margin="0,0,0,10">
            <Grid Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="曝光时间：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtExposure" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="us" Foreground="#888" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="增益：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtGain" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="dB" Foreground="#888" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="像素格式：" Foreground="#CCC" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CbxPixelFormat" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" SelectedIndex="0">
                    <ComboBoxItem Content="Mono8"/>
                    <ComboBoxItem Content="BayerRG8"/>
                    <ComboBoxItem Content="RGB8"/>
                </ComboBox>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="分辨率：" Foreground="#CCC" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="TxtWidth" Width="80" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                    <TextBlock Text=" x " Foreground="#888" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtHeight" Width="80" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="图像翻转" Foreground="#AAA" Margin="0,0,0,10">
            <StackPanel Margin="8,8,8,4" Orientation="Horizontal">
                <CheckBox x:Name="ChkFlipH" Content="水平翻转" Foreground="#CCC" Margin="0,0,30,0"/>
                <CheckBox x:Name="ChkFlipV" Content="垂直翻转" Foreground="#CCC"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="80" Height="32" Margin="0,0,10,0"
                    Background="#FF7B68EE" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" Height="32"
                    Background="#FF3D3D50" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
