<Window x:Class="VisionFramework.UI.Views.ProgramConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="程序配置" Height="480" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="配置 PLC 程序号对应的 VPP 文件路径。PLC 发送 1 运行程序 1，发送 2 运行程序 2，未发送默认程序 1。"
                   Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="+ 添加程序" Width="90" Height="28"
                    Background="#FF7B68EE" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnAdd_Click"/>
            <TextBlock Text="程序号" Foreground="#888" FontSize="11" Margin="24,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="程序名称" Foreground="#888" FontSize="11" Margin="36,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="VPP 路径" Foreground="#888" FontSize="11" Margin="86,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProgramList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Number, StringFormat='#{0}'}" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" Height="26" FontSize="11" Margin="4,0"
                                     Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2"
                                     VerticalContentAlignment="Center"/>
                            <TextBox Grid.Column="2" Text="{Binding VppPath, Mode=TwoWay}" Height="26" FontSize="11" Margin="4,0"
                                     Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="3" Content="..." Width="26" Height="26" Margin="4,0,0,0"
                                    Background="#FF3D3D50" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    FontSize="11" Click="BtnBrowse_Click" Tag="{Binding}"/>
                            <Button Grid.Column="4" Content="✕" Width="26" Height="26" Margin="4,0,0,0"
                                    Background="#FF5C3D3D" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    FontSize="11" Click="BtnRemove_Click" Tag="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="80" Height="32" Margin="0,0,10,0"
                    Background="#FF7B68EE" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" Height="32"
                    Background="#FF3D3D50" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
