<Window x:Class="VisionFramework.UI.Views.SimpleInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Height="200" Width="340"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="LblPrompt1" Foreground="#CCC" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="TxtInput1" Height="28" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
        <TextBlock Grid.Row="2" x:Name="LblPrompt2" Foreground="#CCC" Margin="0,12,0,4"/>
        <TextBox Grid.Row="3" x:Name="TxtInput2" Height="28" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="70" Height="28" Margin="0,0,8,0" Background="#FF7B68EE" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnOk_Click"/>
            <Button Content="取消" Width="70" Height="28" Background="#FF3D3D50" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
