<Window x:Class="VisionFramework.UI.Views.RecordHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检测记录" Height="560" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：统计 + 操作 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="TblStats" Foreground="#CCC" FontSize="13" VerticalAlignment="Center"/>
            <Button Content="刷新" Width="70" Height="28" Margin="16,0,0,0"
                    Background="#FF3D3D50" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnRefresh_Click"/>
        </StackPanel>

        <!-- 记录表格 -->
        <DataGrid Grid.Row="1" x:Name="DgRecords" Background="#FF2D2D3F" Foreground="#CCC"
                  BorderBrush="#444" RowBackground="#FF2D2D3F" AlternatingRowBackground="#FF262638"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                <DataGridTextColumn Header="产品" Binding="{Binding ProductName}" Width="90"/>
                <DataGridTextColumn Header="VPP" Binding="{Binding VppName}" Width="150"/>
                <DataGridTextColumn Header="结果" Binding="{Binding IsOk}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOk}" Value="True">
                                    <Setter Property="Text" Value="OK"/>
                                    <Setter Property="Foreground" Value="#00E676"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOk}" Value="False">
                                    <Setter Property="Text" Value="NG"/>
                                    <Setter Property="Foreground" Value="#FF3B30"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="耗时(ms)" Binding="{Binding DurationMs}" Width="80"/>
                <DataGridTextColumn Header="输出值" Binding="{Binding OutputsJson}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="关闭" Width="80" Height="28"
                    Background="#FF3D3D50" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
