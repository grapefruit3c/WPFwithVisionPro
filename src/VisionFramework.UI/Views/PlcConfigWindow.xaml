<Window x:Class="VisionFramework.UI.Views.PlcConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC 通信配置" Height="620" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接参数 -->
        <GroupBox Grid.Row="0" Header="连接参数" Foreground="#AAA" Margin="0,0,0,10">
            <Grid Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC IP：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtIp" Height="28" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="端口：" Foreground="#CCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtPort" Height="28" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="PLC 类型：" Foreground="#CCC" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbxPlcType" Height="28" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" SelectedIndex="0">
                    <ComboBoxItem Content="Siemens (西门子)"/>
                    <ComboBoxItem Content="Mitsubishi (三菱)"/>
                    <ComboBoxItem Content="Omron (欧姆龙)"/>
                    <ComboBoxItem Content="Modbus TCP"/>
                </ComboBox>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Rack/Slot：" Foreground="#CCC" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="TxtRack" Width="60" Height="28" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center" Text="0"/>
                    <TextBlock Text="/" Foreground="#888" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBox x:Name="TxtSlot" Width="60" Height="28" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center" Text="1"/>
                </StackPanel>
                <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" x:Name="BtnTestConnection" Content="测试连接" Height="28" Margin="8,0,0,0"
                        Background="#FF3D3D50" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="BtnTestConnection_Click"/>
            </Grid>
        </GroupBox>

        <!-- 握手信号地址 -->
        <GroupBox Grid.Row="1" Header="握手时序与信号地址" Foreground="#AAA" Margin="0,0,0,10">
            <Grid Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="触发信号地址：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtTrigger" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="触发应答地址：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtTriggerAck" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="结果回写地址：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtResult" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="结果数据地址：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtResultData" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="心跳信号地址：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtHeartbeat" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="程序号地址：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtProgramNumber" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- 心跳参数 -->
        <GroupBox Grid.Row="2" Header="心跳与超时" Foreground="#AAA" Margin="0,0,0,10">
            <Grid Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="心跳周期(ms)：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtHeartbeatInterval" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="ms" Foreground="#888" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ping 超时(ms)：" Foreground="#CCC" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtPingTimeout" Height="26" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" Foreground="#888" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="80" Height="32" Margin="0,0,10,0"
                    Background="#FF7B68EE" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" Height="32"
                    Background="#FF3D3D50" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
