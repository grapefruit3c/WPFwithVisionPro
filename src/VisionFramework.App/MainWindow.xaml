<Window x:Class="VisionFramework.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:VisionFramework.UI.Controls;assembly=VisionFramework.UI"
        Title="VisionFramework — 分层架构视觉框架" Height="760" Width="1320"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- 左：显示区 -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="显示区" FontWeight="Bold" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding StatusText}" Foreground="Gray"/>
            </StackPanel>
            <ctl:VisionDisplayControl x:Name="DisplayControl" Grid.Row="1"/>
        </Grid>

        <!-- 右：控制面板 -->
        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="120"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <WrapPanel>
                    <Button Content="加载 VPP" Width="90" Margin="0,0,8,6" Command="{Binding LoadVppCommand}"/>
                    <Button Content="加载图片" Width="90" Margin="0,0,8,6" Command="{Binding LoadImageCommand}"/>
                    <Button Content="运行" Width="70" Margin="0,0,8,6" Command="{Binding RunCommand}"/>
                    <Button Content="适配" Width="50" Margin="0,0,0,6" Command="{Binding FitCommand}"/>
                </WrapPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{Binding VppInfo}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"/>

            <GroupBox Grid.Row="2" Header="输入终端" Margin="0,0,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding InputTerminals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Name}" Width="140" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <TextBox Width="120" Text="{Binding Value, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="输出结果" Margin="0,0,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding OutputTerminals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Row="4" Header="日志">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}"/>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</Window>