<Window x:Class="VisionFramework.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:VisionFramework.UI.Controls;assembly=VisionFramework.UI"
        xmlns:cfg="clr-namespace:VisionFramework.Core.Configuration;assembly=VisionFramework.Core"
        Title="VisionFramework — 机器视觉检测系统" Height="820" Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="#FF1A1A28">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═══ 顶部栏 ═══ -->
        <Border DockPanel.Dock="Top" Background="#FF151523" Height="40">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text=" VF" FontSize="18" FontWeight="Bold" Foreground="#7B68EE"/>
                    <TextBlock Text="VisionFramework" FontSize="14" Foreground="#CCC" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0.0" FontSize="11" Foreground="#666" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="👤" Foreground="#7B68EE" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TblUser" Text="admin" Foreground="#CCC" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="|" Foreground="#444" Margin="12,0,12,0"/>
                    <Button Content="系统信息" Style="{StaticResource ToolbarBtn}" Click="BtnSysInfo_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 工具栏 ═══ -->
        <Border DockPanel.Dock="Top" Background="#FF1E1E2E" Height="44" BorderBrush="#333" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                <Button Content="📁 加载VPP" Style="{StaticResource ToolbarBtn}" Command="{Binding LoadVppCommand}"/>
                <Button Content="🖼 加载图片" Style="{StaticResource ToolbarBtn}" Command="{Binding LoadImageCommand}"/>
                <Button Content="▶ 运行" Style="{StaticResource ToolbarBtn}" Command="{Binding RunCommand}"/>
                <Button Content="🔍 适配" Style="{StaticResource ToolbarBtn}" Command="{Binding FitCommand}"/>
                <TextBlock Text="|" Foreground="#444" Margin="8,0,8,0" VerticalAlignment="Center"/>
                <Button Content="🔧 进入程序" Style="{StaticResource ToolbarBtn}" Background="#FF7B68EE" Click="BtnOpenVpp_Click"/>
            </StackPanel>
        </Border>

        <!-- ═══ 状态栏 ═══ -->
        <Border DockPanel.Dock="Bottom" Background="#FF151523" Height="32" BorderBrush="#333" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ctl:StatusLight x:Name="LightPlc" Label="PLC" Margin="0,0,20,0"/>
                    <ctl:StatusLight x:Name="LightCamera" Label="相机" Margin="0,0,20,0"/>
                    <ctl:StatusLight x:Name="LightHeartbeat" Label="心跳" Margin="0,0,20,0"/>
                    <ctl:StatusLight x:Name="LightPing" Label="Ping" Margin="0,0,20,0"/>
                    <TextBlock Text="|" Foreground="#444" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock Text="磁盘: " Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TblDiskInfo" Text="--" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding StatusText}" Foreground="#7B68EE" FontSize="12"/>
            </Grid>
        </Border>

        <!-- ═══ 主内容区 ═══ -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 左：显示区 -->
            <Grid Grid.Column="0" Margin="4">
                <ctl:VisionDisplayControl x:Name="DisplayControl"/>
            </Grid>

            <!-- 右：控制面板 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="4,0,0,0">
                <StackPanel>
                    <!-- VPP 信息 -->
                    <GroupBox Header="VPP 信息">
                        <TextBlock Text="{Binding VppInfo}" Foreground="#CCC" FontSize="12" TextWrapping="Wrap"/>
                    </GroupBox>

                    <!-- 输入终端 / Job 列表 -->
                    <GroupBox Header="Job 列表 / 输入终端">
                        <ItemsControl ItemsSource="{Binding InputTerminals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" Width="120" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox Width="140" Text="{Binding Value, Mode=TwoWay}" Background="#FF2D2D3F" Foreground="White" BorderBrush="#444"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <!-- 输出结果 -->
                    <GroupBox Header="输出结果">
                        <ItemsControl ItemsSource="{Binding OutputTerminals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" Foreground="#7B68EE" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Value}" Foreground="#CCC" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <!-- 系统配置 -->
                    <GroupBox Header="系统配置">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Content="PLC 配置" Style="{StaticResource ConfigBtn}" Click="BtnPlcConfig_Click"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="相机配置" Style="{StaticResource ConfigBtn}" Click="BtnCameraConfig_Click"/>
                                <Button Grid.Row="1" Grid.Column="0" Content="存图配置" Style="{StaticResource ConfigBtn}" Click="BtnSaveImageConfig_Click"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="PLC 监控" Style="{StaticResource ConfigBtn}" Click="BtnPlcMonitor_Click"/>
                                <Button Grid.Row="2" Grid.Column="0" Content="用户设置" Style="{StaticResource ConfigBtn}" Click="BtnUserSettings_Click"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="系统信息" Style="{StaticResource ConfigBtn}" Click="BtnSysInfo_Click"/>
                            </Grid>
                            <TextBlock Text="VisionPro 路径" Foreground="#AAA" FontSize="11" Margin="0,8,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtVisionProPath" Height="26" FontSize="11"
                                         Background="#FF2D2D3F" Foreground="White" BorderBrush="#444" Padding="6,2"
                                         VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="浏览" Height="26" Margin="6,0,0,0"
                                        Background="#FF3D3D50" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        FontSize="11" Click="BtnBrowseVp_Click"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 日志 -->
                    <GroupBox Header="日志">
                        <ItemsControl ItemsSource="{Binding Logs}" MaxHeight="200">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#888" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
