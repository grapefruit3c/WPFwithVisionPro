<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{A1B2C3D4-E5F6-4789-ABCD-EF0123456789}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>VisionProVppHost</RootNamespace>
    <AssemblyName>VisionProVppHost</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x86</PlatformTarget>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <!-- 本机 VisionPro 安装路径（32 位） -->
    <CognexDir>C:\Program Files (x86)\Cognex\VisionPro</CognexDir>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\x86\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- .NET Framework 基础引用 -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!--
    VisionPro 引用：编译时引用 ReferencedAssemblies，运行时从 GAC_32 解析（Private=False 不复制）。
    若你的 vpp 用到 PMAlign/Caliper/Blob/OCR 等工具，按需补充对应 DLL（同样来自 ReferencedAssemblies）：
      Cognex.VisionPro.PMAlign.dll / Cognex.VisionPro.Caliper.dll / Cognex.VisionPro.Blob.dll ...
  -->
  <ItemGroup>
    <Reference Include="Cognex.VisionPro.Core">
      <HintPath>$(CognexDir)\ReferencedAssemblies\Cognex.VisionPro.Core.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Cognex.VisionPro">
      <HintPath>$(CognexDir)\ReferencedAssemblies\Cognex.VisionPro.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Cognex.VisionPro.Display.Controls">
      <HintPath>$(CognexDir)\ReferencedAssemblies\Cognex.VisionPro.Display.Controls.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Cognex.VisionPro.QuickBuild.Core">
      <HintPath>$(CognexDir)\ReferencedAssemblies\Cognex.VisionPro.QuickBuild.Core.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Cognex.VisionPro.ToolGroup">
      <HintPath>$(CognexDir)\ReferencedAssemblies\Cognex.VisionPro.ToolGroup.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Cognex.VisionPro.Controls">
      <HintPath>$(CognexDir)\ReferencedAssemblies\Cognex.VisionPro.Controls.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Cognex.VisionPro.ImageFile">
      <HintPath>$(CognexDir)\ReferencedAssemblies\Cognex.VisionPro.ImageFile.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <!-- WPF Application Definition -->
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
  </ItemGroup>

  <!-- WPF Pages (XAML) -->
  <ItemGroup>
    <Page Include="MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Controls\VisionProHostControl.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <!-- C# 编译项 -->
  <ItemGroup>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="Controls\VisionProHostControl.xaml.cs">
      <DependentUpon>VisionProHostControl.xaml</DependentUpon>
    </Compile>
    <Compile Include="Core\CogImageHelper.cs" />
  </ItemGroup>

  <!-- 导入 C# 构建目标（内部已包含 WPF/WinFX 支持） -->
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

</Project>
