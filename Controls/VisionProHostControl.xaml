<UserControl x:Class="VisionProVppHost.Controls.VisionProHostControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfint="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- 左：显示区 -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="显示区" FontWeight="Bold" Margin="0,0,12,0"/>
                <TextBlock x:Name="TbImageInfo" Text="未加载图像" Foreground="Gray"/>
            </StackPanel>
            <Border Grid.Row="1" BorderBrush="#888" BorderThickness="1" Background="Black">
                <Grid>
                    <wfint:WindowsFormsHost x:Name="ImageHost"/>
                    <wfint:WindowsFormsHost x:Name="RecordHost" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 右：控制面板 -->
        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="VPP 控制" FontWeight="Bold" Margin="0,0,0,6"/>
                <WrapPanel>
                    <Button x:Name="BtnLoadVpp" Content="加载 VPP" Width="100" Margin="0,0,8,6" Click="BtnLoadVpp_Click"/>
                    <Button x:Name="BtnLoadImage" Content="加载图片" Width="100" Margin="0,0,8,6" Click="BtnLoadImage_Click" IsEnabled="False"/>
                    <Button x:Name="BtnRun" Content="运行" Width="80" Margin="0,0,8,6" Click="BtnRun_Click" IsEnabled="False"/>
                    <Button x:Name="BtnFit" Content="适配" Width="60" Margin="0,0,0,6" Click="BtnFit_Click" IsEnabled="False"/>
                </WrapPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="TbVppInfo" Text="未加载 VPP" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"/>

            <GroupBox Grid.Row="2" Header="输入终端" Margin="0,0,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="InputsPanel"/>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="输出结果" Margin="0,0,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OutputsPanel"/>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Row="4" Header="日志">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LogPanel"/>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
